# Server Configuration
BIND_HOST=127.0.0.1
PORT=8000
API_TOKEN=
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Packet Sniffing & Capture
NETWORK_INTERFACE=
BPF_FILTER=
MAX_QUEUE_SIZE=10000

# GeoIP Databases & PCAP Replay
GEOLITE2_CITY_DB=GeoLite2-City.mmdb
GEOLITE2_ASN_DB=GeoLite2-ASN.mmdb
REPLAY_PCAP_PATH=

# Performance & Retention
BATCH_INTERVAL_MS=500
RETENTION_HOURS=24

# Default Local Location (Fallback if public IP lookup fails)
LOCAL_LAT=37.7749
LOCAL_LNG=-122.4194
